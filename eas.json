{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "distribution": "internal",
      "node": "22.13.0",

      "env": {
        "EXPO_PUBLIC_API_URL": "https://piketar-production.up.railway.app"
      },

      "android": {
        "buildType": "apk"
      }
    },

    "production": {
      "autoIncrement": true
    }
  },

  "submit": {
    "production": {}
  }
}